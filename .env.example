# Recount reads these on the server only. The glasses app never sees a token.
# Leave them blank to run in mock mode: a built-in shop, a local Telegram outbox,
# and the regex count parser.

PORT=4187

# mock (default when Notion is unset) or live
RECOUNT_MODE=mock

# Notion internal integration. Share the parent page with the integration.
# Required for RECOUNT_MODE=live and for npm run seed.
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_PARENT_PAGE_ID=

# Telegram bot from @BotFather, and the chat that should receive the report.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional OpenAI-compatible chat endpoint. With no key, spoken counts use the
# built-in parser ("twelve", "two boxes of six", "twenty-one, two damaged").
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional speech-to-text for an injected or captured WAV. Same key and base URL.
# Model is sent to POST {LLM_BASE_URL}/audio/transcriptions.
LLM_STT_MODEL=whisper-1
